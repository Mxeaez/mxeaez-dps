# mxeaez fork: production build for https://dps.mxeaez.com (served at the site root; see docs/DEPLOY.md).
# Upstream values were BASE_URL=https://tools.runescape.wiki, BASE_PATH=/osrs-dps, SHORTLINK_URL=https://dps.osrs.wiki.
NEXT_PUBLIC_BASE_URL=https://dps.mxeaez.com
# Empty base path: the app lives at the root of the domain.
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_SHORTLINK_URL=https://dps.mxeaez.com
# Images come from our own copy of cdn/ (copied into out/cdn by scripts/copyCdn.mjs after `next build`).
NEXT_PUBLIC_CDN_URL=/cdn
# The shortlink backend is the OSRS Wiki's; the Share button shows a notice instead of calling it.
NEXT_PUBLIC_DISABLE_SHORTLINKS=true
NEXT_PUBLIC_LOCAL_STORE_SHORTLINKS=true
